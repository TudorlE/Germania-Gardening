# web.de SMTP credentials for the contact form (preferred)
# 1. Log in to web.de → Einstellungen → POP3/IMAP Abruf
#    → enable "POP3 und IMAP Zugriff erlauben" (also allows SMTP sending).
# 2. Use the full web.de address and its password below.
#    If 2-factor login is enabled, create an "Anwendungsspezifisches Passwort" and use that.
# 3. Rename this file to ".env.local" — never commit the real values.

WEBDE_USER=mpetrasco@web.de
WEBDE_PASSWORD=your-web.de-password

# Optional fallback: Gmail SMTP (only used when WEBDE_* are not set)
# GMAIL_USER=your-sender-address@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where contact form messages will be delivered.
# Defaults to mpetrasco@web.de if omitted.
CONTACT_TO=mpetrasco@web.de
